# ==========================================
# Dota 2 Drafter - Environment Configuration
# ==========================================

# Backend Configuration
ENV=production
DEBUG=false
PORT=8000
HOST=0.0.0.0
MODEL_DIR=./backend/model
PREDICTION_ENGINE=combined

# Security & CORS
CORS_ORIGINS=["*"]
ADMIN_API_KEY=change-me-in-production

# Telegram Supervisor Bot (Optional)
TELEGRAM_TOKEN=

# Database URL (Optional for collector/orchestrator)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dota

# Frontend API Endpoint
VITE_API_URL=http://localhost:8000
